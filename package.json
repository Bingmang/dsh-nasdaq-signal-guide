{
  "name": "dsh-nasdaq-signal-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Nasdaq three-signal dashboard panel for DeepSeek Harness, with automatic daily data sync.",
  "license": "MIT",
  "author": "Bingmang",
  "homepage": "https://github.com/Bingmang/dsh-nasdaq-signal-guide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bingmang/dsh-nasdaq-signal-guide.git"
  },
  "bugs": {
    "url": "https://github.com/Bingmang/dsh-nasdaq-signal-guide/issues"
  },
  "type": "module",
  "displayName": "纳指三信号决策仪",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "nasdaq",
    "signal"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "client-src",
    "build-client.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node build-client.mjs",
    "check": "node --check index.js && node --check host/signals.js && node --check host/store.js && node --check host/updater.js && node --check build-client.mjs && node --check client.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
